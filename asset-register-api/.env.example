NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:5173
# Use exact comma-separated HTTPS origins in production. Whitespace is trimmed.
DATABASE_URL=postgres://asset_app:change-me@localhost:5432/incuspaze_assets
# Production URLs must include sslmode=verify-full and any provider-specific CA configuration.
OIDC_ISSUER_URL=
OIDC_AUDIENCE=
OIDC_JWKS_URL=
# Generate and keep the Ed25519 private key in the API secret manager only.
# Keep retired public keys in this JSON map while old QR labels remain in use.
ASSET_QR_SIGNING_KEY_ID=
ASSET_QR_SIGNING_PRIVATE_KEY=
ASSET_QR_VERIFY_PUBLIC_KEYS_JSON={}
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_REGION=ap-south-1
OBJECT_STORAGE_KMS_KEY_ID=
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
